
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FASTOR - Thiết Bị Văn Phòng & Công Nghệ</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            orange: '#ff5e15',
                            dark: '#2d2d2d',
                            blue: '#00a8ff',
                            yellow: '#ffd32a',
                            cyan: '#0fbcf9',
                            graybg: '#f8f9fa'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        html {
            scroll-behavior: smooth;
        }

        .section-title {
            position: relative;
            display: inline-block;
            padding-bottom: 10px;
        }

            .section-title::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 50px;
                height: 2px;
                background-color: #d1d5db;
            }

        .cat-block {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .cat-block:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 30px rgba(0,0,0,0.1);
                z-index: 10;
            }

        /* Custom scrollbar for webkit */
        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #ff5e15;
            border-radius: 4px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #e04e0e;
            }
    </style>
</head>
<body class="font-sans text-gray-800 bg-white flex flex-col min-h-screen">

    <!-- Top Contact Bar -->
    <div class="bg-gray-100 text-gray-500 text-xs py-2 border-b border-gray-200 hidden md:block">
        <div class="max-w-7xl mx-auto px-4 flex justify-between items-center">
            <div><i class="fas fa-truck mr-1"></i> Miễn phí vận chuyển & Hoàn trả</div>
            <div class="flex space-x-6">
                <span><i class="fas fa-shield-alt mr-1"></i> Đảm bảo hoàn tiền</span>
                <span><i class="fas fa-headset mr-1"></i> Hỗ trợ 24/7</span>
            </div>
        </div>
    </div>

    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-wrap justify-between items-center py-4 md:h-24">
                <!-- Logo -->
                <div class="w-full md:w-auto flex justify-between items-center mb-4 md:mb-0">
                    <a href="#" class="text-4xl font-extrabold tracking-widest text-black uppercase">Fastor</a>
                    <!-- Mobile Menu Button -->
                    <button class="md:hidden text-gray-600 hover:text-brand-orange focus:outline-none">
                        <i class="fas fa-bars text-2xl"></i>
                    </button>
                </div>

                <!-- Search Bar -->
                <div class="w-full md:w-1/2 flex-1 md:px-8 mb-4 md:mb-0 order-last md:order-none">
                    <form onsubmit="event.preventDefault();" class="flex border-2 border-brand-orange rounded-full overflow-hidden">
                        <input type="text" class="flex-1 px-4 py-2 text-sm focus:outline-none" placeholder="Tìm kiếm sản phẩm, danh mục...">
                        <button type="submit" class="bg-brand-orange text-white px-6 py-2 hover:bg-orange-600 transition">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Contact Info & Cart -->
                <div class="hidden md:flex items-center space-x-6">
                    <div class="flex items-center text-gray-600">
                        <i class="fas fa-phone-alt text-brand-orange text-2xl mr-3"></i>
                        <div class="leading-tight">
                            <span class="block text-xs uppercase font-bold text-gray-400">Gọi cho chúng tôi</span>
                            <span class="block font-bold text-lg text-black">500-130-120</span>
                        </div>
                    </div>

                    <div class="flex items-center space-x-4 border-l pl-6">
                        <a href="#" class="text-gray-600 hover:text-brand-orange transition"><i class="fas fa-user text-xl"></i></a>
                        <a href="#" class="relative p-2 text-gray-600 hover:text-brand-orange transition group">
                            <i class="fas fa-shopping-basket text-2xl group-hover:scale-110 transition-transform"></i>
                            <span class="absolute top-0 right-0 inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white transform translate-x-1/4 -translate-y-1/4 bg-brand-orange rounded-full">3</span>
                        </a>
                        <span class="font-bold text-gray-800">$0.00</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Orange Navigation Bar -->
        <div class="bg-brand-orange hidden md:block">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <ul class="flex flex-wrap space-x-8 py-3 text-sm font-semibold text-white uppercase tracking-wider">
                    <li><a href="#" class="hover:text-yellow-200 transition">Trang chủ</a></li>
                    <li><a href="#" class="hover:text-yellow-200 transition text-yellow-200">Sản phẩm</a></li>
                    <li><a href="#" class="hover:text-yellow-200 transition flex items-center">Công nghệ <i class="fas fa-angle-down ml-1"></i></a></li>
                    <li><a href="#" class="hover:text-yellow-200 transition flex items-center">Nội thất <i class="fas fa-angle-down ml-1"></i></a></li>
                    <li><a href="#" class="hover:text-yellow-200 transition">Văn phòng phẩm</a></li>
                    <li><a href="#" class="hover:text-yellow-200 transition">Liên hệ</a></li>
                </ul>
            </div>
        </div>
    </header>

    <section class="relative bg-gray-900 h-[400px] md:h-[550px] flex items-center justify-center text-center text-white">
        <!-- Unsplash Office Background -->
