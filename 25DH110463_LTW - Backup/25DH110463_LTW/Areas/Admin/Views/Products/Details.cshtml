@model _25DH110463_LTW.Models.Product

@{
    ViewBag.Title = "Chi tiết Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card mt-4" style="max-width: 900px; margin: 0 auto; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: none;">
    <div class="card-header bg-info text-white text-center" style="font-size: 1.25rem; font-weight: bold; text-transform: uppercase;">
        <i class="fa fa-info-circle"></i> THÔNG TIN CHI TIẾT SẢN PHẨM
    </div>
    <div class="card-body p-0">
        <div class="row g-0">
            <!-- Cột chứa hình ảnh -->
            <div class="col-md-4 p-4 text-center bg-light border-end d-flex align-items-center justify-content-center">
                <img src="@Model.ProductImage" alt="@Model.ProductName" class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/300x400?text=No+Image'" />
            </div>
            <!-- Cột chứa thông tin -->
            <div class="col-md-8 p-4">
                <h3 class="text-primary mb-3 fw-bold">@Html.DisplayFor(model => model.ProductName)</h3>

                <table class="table table-borderless mb-0">
                    <tbody>
                        <tr>
                            <th style="width: 30%; color: #7f8c8d;">Danh mục:</th>
                            <td class="fw-bold">@Html.DisplayFor(model => model.Category.CategoryName) (ID: @Model.CategoryID)</td>
                        </tr>
                        <tr>
                            <th style="color: #7f8c8d;">Giá bán:</th>
                            <td><span class="badge bg-success" style="font-size: 1.1rem;">@String.Format("{0:N0}", Model.ProductPrice) VNĐ</span></td>
                        </tr>
                        <tr>
                            <th style="color: #7f8c8d;">Mô tả:</th>
                            <td style="line-height: 1.6; text-align: justify;">@Html.DisplayFor(model => model.ProductDecription)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white text-center py-3">
        @Html.ActionLink("Sửa Sản phẩm", "Edit", new { id = Model.ProductID }, new { @class = "btn btn-warning px-4 fw-bold" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
    </div>
</div>